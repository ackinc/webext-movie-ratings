{
  "manifest_version": 3,
  "name": "Sift: IMDB ratings on various OTT platforms. Free & Open Source.",
  "description": "Sift adds IMDB ratings next to programs on various OTT platforms to help you choose what to watch faster.",
  "version": "7.0.4",
  "icons": {
    "16": "images/logo16.png",
    "32": "images/logo32.png",
    "48": "images/logo48.png",
    "128": "images/logo128.png"
  },
  "author": "anirudh.nimmagadda@gmail.com",
  "content_scripts": [
    {
      "js": ["content-script.js"],
      "matches": [
        "https://www.hotstar.com/*",
        "https://www.sonyliv.com/*",
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://tv.apple.com/*",
        "https://www.crunchyroll.com/*",
        "https://www.youtube.com/*"
      ]
    },
    {
      "js": ["urlchange-dispatcher.js"],
      "matches": [
        "https://www.hotstar.com/*",
        "https://www.sonyliv.com/*",
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://tv.apple.com/*",
        "https://www.crunchyroll.com/*",
        "https://www.youtube.com/*"
      ],
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": "images/logo32.png"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://www.hotstar.com/*",
    "https://www.sonyliv.com/*",
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.amazon.com/gp/video/*",
    "https://tv.apple.com/*",
    "https://www.crunchyroll.com/*",
    "https://www.youtube.com/*"
  ]
}
