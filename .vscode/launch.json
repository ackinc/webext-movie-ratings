  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run program",
      "skipFiles": ["<node_internals>/**"],
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "args": [],
      "outFiles": ["${workspaceFolder}/**/*.js"],
      "envFile": "${workspaceFolder}/packages/api-server/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run API server",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/packages/api-server/server.ts",
      "cwd": "${workspaceFolder}",
      "args": [],
      "outFiles": ["${workspaceFolder}/**/*.js"],
      "envFile": "${workspaceFolder}/packages/api-server/.env",
      "outputCapture": "std"
    }
  ]
}
