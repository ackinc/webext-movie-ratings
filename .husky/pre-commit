WS_ROOT=`dirname $(dirname $0)`
LANDING_PAGE_PACKAGE_PATH="packages/landing-page"

# if changes were made to the landing page, build the landing page and commit
#   the build output as well
if git diff --cached --name-only | grep -q "^$LANDING_PAGE_PACKAGE_PATH/"; then
  pnpm run --filter "./$LANDING_PAGE_PACKAGE_PATH" build
  git add "$WS_ROOT/$LANDING_PAGE_PACKAGE_PATH/dist"
fi
