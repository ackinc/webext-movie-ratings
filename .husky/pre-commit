WS_ROOT=`dirname $(dirname $0)`
WEBSITE_PACKAGE_PATH="packages/website"

# if changes were made to the website, build it and commit the build output
if git diff --cached --name-only | grep -q "^$WEBSITE_PACKAGE_PATH/"; then
  pnpm run --filter "./$WEBSITE_PACKAGE_PATH" build
  git add "$WS_ROOT/$WEBSITE_PACKAGE_PATH/dist"
fi
