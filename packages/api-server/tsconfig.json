{
  "include": ["**/*"],
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,

    "types": ["node", "async", "better-sqlite3", "yargs"],
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "erasableSyntaxOnly": true
  }
}
