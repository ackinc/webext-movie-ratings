{
  "name": "sift-web-extension",
  "version": "9.0.2",
  "main": "index.js",
  "scripts": {
    "build:dev": "APP_ENV=development pnpm run build --watch",
    "prebuild": "pnpm run clean && mkdir -p dist && cp -r ../../images dist",
    "build": "node scripts/build.ts",
    "bump-version": "node scripts/bumpVersion.ts",
    "zip:dist": "./scripts/zipDist.sh",
    "zip:src": "./scripts/zipSrc.sh",
    "zip:all": "./scripts/zipAll.sh",
    "clean": "rm -rf dist dist.zip src.zip",
    "publish": "./scripts/publish",
    "publish:all": "./scripts/publish ALL"
  },
  "author": "Anirudh Nimmagadda <anirudh.nimmagadda@gmail.com>",
  "license": "ISC",
  "description": "Sift adds IMDB ratings next to programs on various OTT platforms to help you choose what to watch faster.",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@sentry/esbuild-plugin": "^5.2.1",
    "@sentry/react": "^10.32.1",
    "@types/chrome": "^0.1.32",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.9",
    "@types/yargs": "^17.0.35",
    "apexcharts": "^5.10.5",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "esbuild": ">=0.25.0",
    "fs-extra": "^11.3.3",
    "idb": "^8.0.3",
    "jsonwebtoken": "^9.0.3",
    "nouislider": "^15.8.1",
    "playwright": "^1.58.2",
    "preact": "^10.28.2",
    "prettier": "^3.7.4",
    "rate-limit-utils": "^1.0.0",
    "sifttypes": "workspace:types@*",
    "siftutils": "workspace:utils@*",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "yargs": "^18.0.0"
  },
  "type": "module",
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0"
  }
}
