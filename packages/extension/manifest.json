{
  "manifest_version": 3,
  "name": "Sift: IMDB on Netflix, IMDB on Prime, etc. etc.",
  "description": "Sift adds IMDB ratings next to program tiles on various streaming websites.",
  "version": "9.6.0",
  "icons": {
    "16": "images/logo16.png",
    "32": "images/logo32.png",
    "48": "images/logo48.png",
    "128": "images/logo128.png"
  },
  "author": "anirudh.nimmagadda@gmail.com",
  "content_scripts": [],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": "images/logo32.png"
  },
  "permissions": ["scripting", "storage"],
  "optional_host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.de/*",
    "https://www.primevideo.com/*",
    "https://tv.apple.com/*",
    "https://www.crunchyroll.com/*",
    "https://www.disneyplus.com/*",
    "https://www.hbomax.com/*",
    "https://play.hbomax.com/*",
    "https://www.hotstar.com/*",
    "https://www.hulu.com/*",
    "https://www.mxplayer.in/*",
    "https://www.netflix.com/*",
    "https://www.paramountplus.com/*",
    "https://www.peacocktv.com/*",
    "https://www.sonyliv.com/*",
    "https://www.youtube.com/*",
    "https://www.zee5.com/*"
  ]
}
