{
  "name": "sift-movie-ratings-webextension",
  "version": "8.1.4",
  "main": "index.js",
  "scripts": {
    "test": "tsx tests/*.test.ts",
    "browseOTTs": "./scripts/browseOTTs/main.sh",
    "build:dev": "concurrently --names tsc,esbuild 'tsc -b --noEmit --watch --preserveWatchOutput' 'APP_ENV=development pnpm run build --watch'",
    "prebuild": "pnpm run clean && cp -r images dist",
    "build": "node scripts/build.ts",
    "bump-version": "node scripts/bumpVersion.ts",
    "zip:dist": "./scripts/zipDist.sh",
    "zip:src": "./scripts/zipSrc.sh",
    "zip:all": "./scripts/zipAll.sh",
    "clean": "rm -rf dist/* dist.zip src.zip",
    "publish": "./scripts/publish",
    "publish:all": "./scripts/publish ALL"
  },
  "author": "Anirudh Nimmagadda <anirudh.nimmagadda@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ackinc/webext-movie-ratings.git"
  },
  "description": "Sift adds IMDB ratings next to programs on various OTT platforms to help you choose what to watch faster.",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@sentry/esbuild-plugin": "^4.6.1",
    "@sentry/react": "^10.32.1",
    "@types/chrome": "^0.1.32",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.9",
    "@types/yargs": "^17.0.35",
    "apexcharts": "^5.10.5",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "esbuild": ">=0.25.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fs-extra": "^11.3.3",
    "globals": "^15.8.0",
    "idb": "^8.0.3",
    "jsonwebtoken": "^9.0.3",
    "nouislider": "^15.8.1",
    "playwright": "^1.58.2",
    "preact": "^10.28.2",
    "prettier": "^3.7.4",
    "rate-limit-utils": "^1.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "yargs": "^18.0.0"
  },
  "type": "module"
}
